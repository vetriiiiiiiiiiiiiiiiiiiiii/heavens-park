# ── Database ──────────────────────────────────────────────
# SQLite for local development. For production use PostgreSQL:
# change provider in prisma/schema.prisma to "postgresql" and set
# DATABASE_URL="postgresql://user:pass@host:5432/heavenspark"
DATABASE_URL="file:./dev.db"

# ── Admin dashboard (/admin) ──────────────────────────────
ADMIN_PASSWORD="change-me"
ADMIN_SECRET="generate-a-long-random-string"

# ── Optional integrations (leave blank to disable) ────────
# Google reviews (Places API New): https://developers.google.com/maps/documentation/places/web-service
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_ID=""
# Email confirmations via Resend (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="Heavens Park <reservations@example.com>"
STAFF_NOTIFY_EMAIL=""
# SMS / WhatsApp confirmations via Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM=""
